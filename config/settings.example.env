# Copy to .env (gitignored) and fill in. In production, secrets are Docker secrets.

# dev | ci | paper | live
AT_ENV=dev
AT_TENANT_ID=default
AT_ACCOUNT_ID=default
AT_CONFIG_DIR=config
AT_REGISTRY_PATH=var/registry.jsonl
AT_EXECUTION_JOURNAL_PATH=var/execution_journal.json
AT_EXECUTION_QUALITY_PATH=var/execution_quality.jsonl

# Storage and bus
AT_DATABASE_URL=postgresql+asyncpg://autotrader:CHANGE_ME@localhost:5432/autotrader
# Host ports docker compose publishes on 127.0.0.1 (change them if another project already uses them;
# keep AT_DATABASE_URL on the same port)
AT_PG_PORT=5432
AT_REDIS_PORT=6379
AT_GRAFANA_PORT=3000
AT_REDIS_URL=redis://localhost:6379/0

# Research (Claude API). Leave empty to disable research agents.
AT_ANTHROPIC_API_KEY=

# Alerts
AT_TELEGRAM_BOT_TOKEN=
AT_TELEGRAM_CHAT_ID=

# Email fallback for alerts (optional)
AT_SMTP_HOST=
AT_SMTP_PORT=587
AT_SMTP_USER=
AT_SMTP_PASSWORD=
AT_ALERT_EMAIL_FROM=
AT_ALERT_EMAIL_TO=

# API: owner token for control endpoints (at least 32 characters). Empty disables them.
AT_API_OWNER_TOKEN=
AT_AUDIT_PATH=var/audit.jsonl
AT_LEARNING_FREEZE_PATH=var/learning.freeze

# Broker / MT5 bridge
AT_BROKER_LOGIN=
AT_BROKER_PASSWORD=
AT_BROKER_SERVER=
AT_BRIDGE_URL=
# At least 32 characters; the same value is configured on the bridge (Windows VPS).
AT_BRIDGE_TOKEN=

# ---- Only on the Windows VPS (python -m autotrader.mt5_bridge) ----
# Broker server timezone: IANA name or "NY+<h>" (New York close brokers are usually NY+7). Required.
AT_BRIDGE_SERVER_TZ=
# demo for paper runs, real for live. The bridge refuses to start on the other kind of account.
AT_BRIDGE_EXPECT_TRADE_MODE=demo
AT_BRIDGE_SYMBOLS=["EURUSD","GBPUSD","USDJPY","AUDUSD","XAUUSD"]
# Bind to the Tailscale/WireGuard address, never a public interface.
AT_BRIDGE_HOST=127.0.0.1
AT_BRIDGE_PORT=8765

# Keys. The owner private key NEVER lives on a server; only its public key.
AT_OWNER_PUBLIC_KEY_PATH=config/owner_ed25519.pub
# Risk gate decision signing key: mounted only into the risk-gate container.
AT_RISK_DECISION_KEY_PATH=
# Public half, mounted into execution.
AT_RISK_DECISION_PUBLIC_KEY_PATH=

# Engine refuses to run live above this skew vs broker server time
AT_MAX_CLOCK_SKEW_SECONDS=2.0

# OANDA v20 (the easiest demo broker: web API, no MT5, no Windows). Create a practice account and an API
# token at oanda.com; put the real values in .env, never in code.
AT_OANDA_TOKEN=
AT_OANDA_ACCOUNT=
AT_OANDA_ENVIRONMENT=practice
