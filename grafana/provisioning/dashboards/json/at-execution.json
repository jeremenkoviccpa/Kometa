{
  "uid": "at-execution",
  "title": "Execution quality",
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "autotrader"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Mean adverse slippage per hour (price units)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT time_bucket('1 hour', filled_at) AS time, symbol AS metric, avg(slippage)::float AS value FROM execution_quality WHERE slippage IS NOT NULL AND $__timeFilter(filled_at) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Fill latency p50 and p95 (ms)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT time_bucket('1 hour', filled_at) AS time, 'p50' AS metric, percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_ms) AS value FROM execution_quality WHERE $__timeFilter(filled_at) GROUP BY 1 UNION ALL SELECT time_bucket('1 hour', filled_at), 'p95', percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) FROM execution_quality WHERE $__timeFilter(filled_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Spread at fill",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT filled_at AS time, symbol AS metric, spread_at_fill::float AS value FROM execution_quality WHERE $__timeFilter(filled_at) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Worst fills",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT filled_at AS time, symbol, strategy_id, strategy_version, order_type, requested_price, filled_price, slippage, latency_ms FROM execution_quality WHERE $__timeFilter(filled_at) ORDER BY slippage DESC NULLS LAST LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          }
        }
      ]
    }
  ]
}
