{
  "uid": "at-learning",
  "title": "Learning activity",
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "autotrader"
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Model and cost-model activations",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT at AS time, payload->>'model_kind' AS kind, payload->>'model_version' AS version FROM audit_log WHERE event_type = 'ModelVersionActivated' AND $__timeFilter(at) ORDER BY at DESC",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Stage entries per week",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT time_bucket('7 days', at) AS time, payload->>'to_stage' AS metric, count(*) AS value FROM audit_log WHERE event_type = 'StageChanged' AND $__timeFilter(at) GROUP BY 1, 2 ORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Owner commands (pause learning, retire, resume)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT at AS time, actor, payload->>'action' AS action, payload::text AS detail FROM audit_log WHERE event_type = 'OwnerCommand' AND $__timeFilter(at) ORDER BY at DESC",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          }
        }
      ]
    }
  ]
}
