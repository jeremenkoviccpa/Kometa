{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kometa-production-11af.up.railway.app/api/:path*"
    },
    {
      "source": "/research/:path*",
      "destination": "https://kometa-production-11af.up.railway.app/research/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
